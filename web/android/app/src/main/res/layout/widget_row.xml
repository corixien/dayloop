<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/check"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@string/widget_done"
        android:padding="11dp"
        android:src="@drawable/widget_check_off" />

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="7dp"
        android:paddingRight="6dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2" />

            <ImageView
                android:id="@+id/ic_note"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_note"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ic_list"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_list"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/send"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@string/widget_send"
        android:padding="12dp"
        android:src="@drawable/widget_send"
        android:visibility="gone" />
</LinearLayout>
